<?xml version="1.0" encoding="utf-8"?>
<!-- Vela — Google Fonts provider certificates.
     PLACEHOLDER: the string below is NOT a real certificate and must be
     replaced before downloadable fonts will work. Generate the real array
     in Android Studio (res/font → New → Font resource file → Downloadable
     Fonts → pick any Google font → the wizard writes this exact array), or
     paste the documented Google Fonts provider certs from the Android
     downloadable-fonts guide. Until then the provider request fails
     verification and VelaTypography falls back to system sans-serif
     (Roboto) — the app still builds and runs. -->
<resources>
    <string-array name="com_google_android_gms_fonts_certs">
        <item>REPLACE_WITH_REAL_GOOGLE_FONTS_PROVIDER_CERT</item>
    </string-array>
</resources>
